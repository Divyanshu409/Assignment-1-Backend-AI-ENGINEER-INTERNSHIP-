# Copy this file to .env and adjust if needed. .env itself is gitignored.

# "sqlite" (A2 behavior, no Docker needed) or "postgres" (A3, via docker compose)
DB_BACKEND=postgres

# Used only when DB_BACKEND=sqlite
SQLITE_DB_FILE=tasks.db

# Used only when DB_BACKEND=postgres.
# Host is "db" (the compose service name) when the app runs inside Docker,
# or "localhost" when running the app directly on your machine against
# the Dockerized Postgres (port published below).
DATABASE_URL=postgresql://taskuser:taskpass@db:5432/taskdb

# Values below are used by the Postgres container itself (docker-compose.yml).
POSTGRES_USER=taskuser
POSTGRES_PASSWORD=taskpass
POSTGRES_DB=taskdb
